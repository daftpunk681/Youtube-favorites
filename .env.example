# Toutes ces variables sont privées et utilisées uniquement sur le serveur.
# Neon : Connection details → connection string (rôle propriétaire, SSL requis).
# Exemple : postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Générer avec npm run admin:hash. Ne jamais mettre le mot de passe en clair.
ADMIN_PASSWORD_HASH=
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# URL exacte sans slash final. En local : http://localhost:3000
# Sur Vercel : https://votre-application.vercel.app
APP_URL=http://localhost:3000
